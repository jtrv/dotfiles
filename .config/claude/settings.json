{
  "permissions": {
    "deny": [
      "Read(**/.env)",
      "Read(**/.env.local)",
      "Read(**/.env.*.local)",
      "Read(**/.env.production)",
      "Read(**/.env.development)",
      "Read(**/*.pem)",
      "Read(**/*.key)",
      "Read(**/*.p12)",
      "Read(**/*.pfx)",
      "Read(**/id_rsa)",
      "Read(**/id_ecdsa)",
      "Read(**/id_ed25519)",
      "Read(**/.ssh/**)",
      "Read(**/.aws/**)",
      "Read(**/.gnupg/**)",
      "Read(**/.netrc)",
      "Read(**/.npmrc)",
      "Read(**/.pypirc)",
      "Read(**/.git-credentials)",
      "Read(**/credentials.json)",
      "Read(**/secrets.json)",
      "Read(**/secrets.yaml)",
      "Read(**/secrets.yml)",
      "Read(**/terraform.tfvars)"
    ],
    "defaultMode": "auto"
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"/home/sugimoto/.config/claude/hooks/block-secrets.sh\"",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "bash \"/home/sugimoto/.config/claude/hooks/nosleep.sh\" acquire"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"/home/sugimoto/.config/claude/hooks/context-mode-cache-heal.mjs\""
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "cat \"/home/sugimoto/.config/claude/skills/caveman/SKILL.md\"; echo \"SESSION DEFAULT: caveman level = lite. Begin every response at caveman lite unless user switches via /caveman full|ultra.\""
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"/home/sugimoto/.config/claude/hooks/capture-window.sh\""
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"/home/sugimoto/.config/claude/hooks/nosleep.sh\" release"
          },
          {
            "type": "command",
            "command": "bash \"/home/sugimoto/.config/claude/hooks/notify-done.sh\""
          }
        ]
      }
    ],
    "Notification": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"/home/sugimoto/.config/claude/hooks/nosleep.sh\" release"
          },
          {
            "type": "command",
            "command": "bash \"/home/sugimoto/.config/claude/hooks/notify-done.sh\""
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"/home/sugimoto/.config/claude/hooks/nosleep.sh\" release"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"/home/sugimoto/.config/claude/hooks/caveman-track.sh\""
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"/home/sugimoto/.config/claude/hooks/nosleep.sh\" acquire"
          }
        ]
      }
    ]
  },
  "enableWorkflows": true,
  "statusLine": {
    "type": "command",
    "command": "bash \"/home/sugimoto/.config/claude/statusline/statusline.sh\""
  },
  "enabledPlugins": {
    "rust-analyzer-lsp@claude-plugins-official": true,
    "typescript-lsp@claude-plugins-official": true,
    "context7@claude-plugins-official": true,
    "code-simplifier@claude-plugins-official": true,
    "playwright@claude-plugins-official": true,
    "security-guidance@claude-plugins-official": true,
    "ralph-loop@claude-plugins-official": true,
    "vercel@claude-plugins-official": true,
    "pyright-lsp@claude-plugins-official": true,
    "learning-output-style@claude-plugins-official": true,
    "gopls-lsp@claude-plugins-official": true,
    "remember@claude-plugins-official": true,
    "skill-creator@claude-plugins-official": true,
    "ponytail@ponytail": true,
    "context-mode@context-mode": true,
    "codex@openai-codex": true
  },
  "extraKnownMarketplaces": {
    "ponytail": {
      "source": {
        "source": "github",
        "repo": "DietrichGebert/ponytail"
      }
    },
    "context-mode": {
      "source": {
        "source": "github",
        "repo": "mksglu/context-mode"
      }
    },
    "openai-codex": {
      "source": {
        "source": "github",
        "repo": "openai/codex-plugin-cc"
      }
    }
  },
  "skipWorkflowUsageWarning": true,
  "theme": "dark",
  "editorMode": "normal",
  "model": "opus"
}
