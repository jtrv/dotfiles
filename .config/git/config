[advice]
  detachedHead = false
[branch]
  sort = -committerdate
[column]
  ui = auto
[commit]
  template = ./message
  verbose = true
  gpgsign = true
# gh supplies github's https credentials; the empty helper first drops
# any inherited one
[credential "https://github.com"]
  helper =
  helper = !gh auth git-credential
[credential "https://gist.github.com"]
  helper =
  helper = !gh auth git-credential
[core]
  autocrlf = input
  editor = kak
  fsmonitor = false
  pager = delta
  untrackedCache = true
[diff]
  algorithm = histogram
  colorMoved = default
  mnemonicPrefix = true
  renames = true
  submodule = log
  tool = difftastic
[difftool]
  prompt = false
[difftool "difftastic"]
  cmd = difft --display inline "$LOCAL" "$REMOTE"
[fetch]
  all = true
# ssh signing. user.signingkey is set per host in /etc/gitconfig, pointing
# at that host's sops key (nixos-config, nixos/common/default.nix)
[gpg]
  format = ssh
[gpg "ssh"]
  allowedSignersFile = ~/.config/git/allowed_signers
[github]
  user = jtrv
[help]
  autocorrect = prompt
[init]
  defaultBranch = main
[merge]
  conflictstyle = zdiff3
[push]
  autoSetupRemote = true
  default = simple
  followTags = true
[rebase]
  autoSquash = true
  autoStash = true
  updateRefs = true
[rerere]
  enabled = true
  autoupdate = true
[status]
  submoduleSummary = true
[submodule]
  recurse = true
[tag]
  sort = version:refname
  gpgsign = true
[user]
  name = jtrv
  email = 46337843+jtrv@users.noreply.github.com

[include]
  path = ./aliases
  path = ./delta
  path = ./mergiraf

[includeIf "gitdir:~/work/"]
  path = ./work

[includeIf "gitdir:~/.config/dotfiles"]
  path = ./dotfiles-local
[includeIf "gitdir:~/.config/dotfiles/"]
  path = ./dotfiles-local
