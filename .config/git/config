[advice]
  detachedHead = false
[branch]
  sort = -committerdate
[column]
  ui = auto
[commit]
  template = ./message
  verbose = true
  gpgsign = true
[core]
  autocrlf = input
  editor = kak
  fsmonitor = true
  pager = delta
  untrackedCache = true
[diff]
  algorithm = histogram
  colorMoved = default
  mnemonicPrefix = true
  renames = true
  submodule = log
[fetch]
  all = true
[help]
  autocorrect = prompt
[init]
  defaultBranch = main
[merge]
  conflictstyle = zdiff3
[push]
  autoSetupRemote = true
  default = simple
  followTags = true
[rebase]
  autoSquash = true
  autoStash = true
  updateRefs = true
[rerere]
  enabled = true
  autoupdate = true
[status]
  submoduleSummary = true
[submodule]
  recurse = true
[tag]
  sort = version:refname

[include]
  path = ./aliases
  path = ./delta
  path = ./mergiraf
  path = ./secret

[includeIf "gitdir:~/"]
  path = ./personal

[includeIf "gitdir:~/work/"]
  path = ./work
