[advice]
  detachedHead = false
[branch]
  sort = -committerdate
[column]
  ui = auto
[commit]
  template = ./message
  verbose = true
  gpgsign = true
[core]
  autocrlf = input
  editor = kak
  fsmonitor = true
  pager = delta
  untrackedCache = true
[diff]
  algorithm = histogram
  colorMoved = default
  mnemonicPrefix = true
  renames = true
  submodule = log
  tool = difftastic
[difftool]
  prompt = false
[difftool "difftastic"]
  cmd = difft --display inline "$LOCAL" "$REMOTE"
[fetch]
  all = true
# ssh signing. user.signingkey is in the untracked ./personal:
#   signingkey = /home/sugimoto/.ssh/github-personal
# morpheus: set that there (replacing the gpg key id) and upload the pubkey
# as a signing key on github + codeberg; keep the old gpg pubkey so old
# commits stay verified.
[gpg]
  format = ssh
[gpg "ssh"]
  allowedSignersFile = ~/.config/git/allowed_signers
[help]
  autocorrect = prompt
[init]
  defaultBranch = main
[merge]
  conflictstyle = zdiff3
[push]
  autoSetupRemote = true
  default = simple
  followTags = true
[rebase]
  autoSquash = true
  autoStash = true
  updateRefs = true
[rerere]
  enabled = true
  autoupdate = true
[status]
  submoduleSummary = true
[submodule]
  recurse = true
[tag]
  sort = version:refname
  gpgsign = true

[include]
  path = ./aliases
  path = ./delta
  path = ./mergiraf
  path = ./secret

[includeIf "gitdir:~/"]
  path = ./personal

[includeIf "gitdir:~/work/"]
  path = ./work

[includeIf "gitdir:~/.config/dotfiles"]
  path = ./dotfiles-local
[includeIf "gitdir:~/.config/dotfiles/"]
  path = ./dotfiles-local
