[Default Applications]
application/epub=sioyek.desktop;koreader.desktop;
application/pdf=sioyek.desktop;koreader.desktop;firefox.desktop;
audio/*=mpv.desktop;
image/*=imv.desktop;gimp.desktop;
inode/*=pcmanfm.desktop;
model/stl=fstl.desktop;
text/*=kakoune.desktop;
text/html=firefox.desktop;kakoune.desktop;
video/*=mpv.desktop;
x-scheme-handler/about=firefox.desktop;
x-scheme-handler/claude-cli=claude-code-url-handler.desktop;
x-scheme-handler/http=firefox.desktop;
x-scheme-handler/https=firefox.desktop;
x-scheme-handler/terminal=Alacritty.desktop;
x-scheme-handler/tidal=tidal-hifi.desktop;
x-scheme-handler/unknown=firefox.desktop;
