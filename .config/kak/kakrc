# Kakoune with Kakhis
# Author: jtrv

evaluate-commands %sh{
  plugins="$kak_config/bundle"
  mkdir -p "$plugins"
  [ ! -e "$plugins/kak-bundle" ] && \
    git clone -q https://codeberg.org/jdugan6240/kak-bundle "$plugins/kak-bundle"
}
source "%val{config}/bundle/kak-bundle/rc/kak-bundle.kak"
bundle-noload kak-bundle https://codeberg.org/jdugan6240/kak-bundle

evaluate-commands %sh{
  # kak_session starts kak-lsp server instead of printing its rc
  env -u kak_session kak-lsp
  skyspell-kak init
  wud --kakoune
  kak-tree-sitter -vvv -dks --init "$kak_session"
}

source "%val{config}/rc/lsp.kak"
source "%val{config}/rc/modes.kak"
source "%val{config}/rc/display.kak"
source "%val{config}/rc/plugins.kak"

evaluate-commands %sh{
  for f in "$kak_config"/rc/commands/*.kak; do printf 'source %%{%s}\n' "$f"; done
}

source "%val{config}/rc/keys.kak"
source "%val{config}/rc/ui.kak"

evaluate-commands %sh{
  for f in "$kak_config"/contexts/*.kak; do printf 'source %%{%s}\n' "$f"; done
}
