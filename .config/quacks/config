# Defaults for every game; a game's quacks.conf can override any key.
# See `quacks` (~/.local/bin/quacks) for the full key list.

# A pacman-installed Proton: the -slr builds write under ~/.local/share/umu,
# which the sandbox keeps read-only.
proton=/usr/share/steam/compatibilitytools.d/proton-cachyos-native

isolate=1
block_net=1
