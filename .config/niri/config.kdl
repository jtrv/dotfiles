// https://niri-wm.github.io/niri/Configuration:-Introduction

prefer-no-csd

hotkey-overlay {
    skip-at-startup
    hide-not-bound
}

output "eDP-1" {
    mode "1920x1080@60.05"
    scale 1
}

input {
    touchpad {
        tap
        dwt
        dwtp
    }
    warp-mouse-to-focus
    focus-follows-mouse
}

cursor {
    hide-when-typing
    hide-after-inactive-ms 1000
}

layout {
    always-center-single-column
    background-color "#1e1e2ec6"
    gaps 0
    center-focused-column "never"
    preset-column-widths {
        proportion 0.33333
        proportion 0.5
        proportion 0.66667
        proportion 1.0
    }
    preset-window-heights {
        proportion 0.33333
        proportion 0.5
        proportion 0.66667
        proportion 1.0
    }
    default-column-width { proportion 0.5; }
    focus-ring {
        width 1
        active-color "#cdd6f4"
        inactive-color "#11111b"
        urgent-color "#f38ba8"
    }
    struts{
        left 1
        right 1
        top 1
        bottom 1
    }
    border { off; }
    tab-indicator {
        on
        hide-when-single-tab
        width 16
        gap 0
        gaps-between-tabs 16
        length total-proportion=1.0
        position "top"
        place-within-column
    }
    insert-hint { color "#f9e2afc6"; }
}

overview {
    zoom 0.5
    backdrop-color "#11111b"
}

spawn-at-startup "waybar"        // status bar
spawn-at-startup "mako"          // notifications
spawn-at-startup "swayidle" "-w" // idle screen locker
spawn-at-startup "alacritty" "--daemon" // terminal daemon

screenshot-path "~/pictures/screenshots/%Y-%m-%d_%H-%M-%S.png"


layer-rule {
    match namespace="^notifications$"
    block-out-from "screencast"
}

layer-rule {
    match namespace="^wallpaper$"
    place-within-backdrop true
}

// Window rules let you adjust behavior for individual windows.
window-rule {
    open-floating true

    match app-id="easyeffects"
    match app-id="feh"
    match app-id="firefox" title="Pushbullet"
    match app-id="gimp"
    match app-id="popup"
    match app-id=".*" title=".*:notification"
    match app-id=".*" title=".*:splash"
    match app-id=".*" title=".*:dialog"
    match app-id=".*" title=".*:toolbar"
    match app-id=".*" title=".*:utility"
    match title="^Picture-in-Picture$"
}

window-rule {
    block-out-from "screencast"

    match app-id="signal-desktop"
    match app-id="mako"
    match app-id="discord"
}

window-rule {
    match app-id="firefox"
    clip-to-geometry true
}

window-rule {
    match is-active=false

    opacity 0.80
}

// Key bindings - niri defaults with spectrwm customizations
binds {
    // Mod-Shift-/, which is usually the same as Mod-?,
    // shows a list of important hotkeys.
    Mod+Shift+Slash { show-hotkey-overlay; }

    // --- Application Launchers ---
    Mod+P hotkey-overlay-title="launch program"      { spawn "tofi-run"; }
    Mod+A hotkey-overlay-title="launch desktop app"  { spawn "tofi-drun"; }

    // --- Custom Tools ---
    Mod+Return hotkey-overlay-title="terminal: alacritty"           { spawn "alacritty" "msg" "create-window"; }
    Mod+Shift+E hotkey-overlay-title="emoji picker: bemoji"         { spawn "bemoji"; }
    Mod+Shift+P hotkey-overlay-title="clipboard menu: clipcat-menu" { spawn "clipcat-menu"; }
    Mod+Shift+D hotkey-overlay-title="speech to text: dictate"      { spawn "~/.local/bin/dictate"; }
    Mod+V       hotkey-overlay-title="volume mixer: wiremix"        { spawn "alacritty" "msg" "create-window" "--class=popup" "--command=wiremix"; }

    // --- Pomodoro Timer ---
    // Binary: waybar-module-pomodoro
    Mod+Shift+B hotkey-overlay-title="pomodoro toggle" { spawn "waybar-module-pomodoro" "toggle"; }

    // --- Screenshot ---
    Mod+S       hotkey-overlay-title="screenshot: gui"  { spawn "flameshot" "gui"; }
    Mod+Shift+S hotkey-overlay-title="screenshot: full" { spawn "flameshot" "full"; }

    // --- Audio & Hardware ---
    Mod+Shift+TouchpadScrollDown { spawn "wpctl" "set-volume" "@DEFAULT_AUDIO_SINK@" "1%-"; }
    Mod+Shift+TouchpadScrollUp   { spawn "wpctl" "set-volume" "@DEFAULT_AUDIO_SINK@" "1%+"; }
    Mod+Shift+WheelScrollDown    { spawn "wpctl" "set-volume" "@DEFAULT_AUDIO_SINK@" "1%-"; }
    Mod+Shift+WheelScrollUp      { spawn "wpctl" "set-volume" "@DEFAULT_AUDIO_SINK@" "1%+"; }

    XF86AudioRaiseVolume allow-when-locked=true { spawn "~/.local/bin/volume-increase"; }
    XF86AudioLowerVolume allow-when-locked=true { spawn "~/.local/bin/volume-decrease"; }
    XF86AudioMute        allow-when-locked=true { spawn "~/.local/bin/volume-mute"; }
    Mod+Ctrl+M           allow-when-locked=true { spawn "~/.local/bin/volume-mute"; }
    Mod+Shift+M          allow-when-locked=true { spawn "~/.local/bin/mute-mic"; }
    XF86AudioMicMute     allow-when-locked=true { spawn-sh "wpctl set-mute @DEFAULT_AUDIO_SOURCE@ toggle"; }

    XF86MonBrightnessUp   { spawn "~/.local/bin/bright" "+"; }
    XF86MonBrightnessDown { spawn "~/.local/bin/bright" "-"; }

    // --- Notifications (Mako) ---
    Mod+Ctrl+Period       { spawn "makoctl" "dismiss"; }
    Mod+Ctrl+Shift+Period { spawn "makoctl" "dismiss" "-a"; }
    Mod+Ctrl+Comma        { spawn "makoctl" "restore"; }

    // --- Media Keys (from spectrwm) ---
    XF86AudioPlay  allow-when-locked=true { spawn-sh "playerctl play-pause"; }
    XF86AudioStop  allow-when-locked=true { spawn-sh "playerctl stop"; }
    XF86AudioPrev  allow-when-locked=true { spawn-sh "playerctl previous"; }
    XF86AudioNext  allow-when-locked=true { spawn-sh "playerctl next"; }

    // --- Navigation (niri defaults) ---
    Mod+Left  { focus-column-left; }
    Mod+Down  { focus-window-down; }
    Mod+Up    { focus-window-up; }
    Mod+Right { focus-column-right; }
    Mod+H     { focus-column-left; }
    Mod+J     { focus-window-down; }
    Mod+K     { focus-window-up; }
    Mod+L     { focus-column-right; }

    // --- Move Windows (niri defaults) ---
    Mod+Shift+Left  { move-column-left; }
    Mod+Shift+Down  { move-window-down; }
    Mod+Shift+Up    { move-window-up; }
    Mod+Shift+Right { move-column-right; }
    Mod+Shift+H     { move-column-left; }
    Mod+Shift+J     { move-window-down; }
    Mod+Shift+K     { move-window-up; }
    Mod+Shift+L     { move-column-right; }

    // --- Workspace (niri defaults) ---
    Mod+1 { focus-workspace 1; }
    Mod+2 { focus-workspace 2; }
    Mod+3 { focus-workspace 3; }
    Mod+4 { focus-workspace 4; }
    Mod+5 { focus-workspace 5; }
    Mod+6 { focus-workspace 6; }
    Mod+7 { focus-workspace 7; }
    Mod+8 { focus-workspace 8; }
    Mod+9 { focus-workspace 9; }
    Mod+Tab { focus-workspace-previous; }
    Mod+Shift+1 { move-column-to-workspace 1; }
    Mod+Shift+2 { move-column-to-workspace 2; }
    Mod+Shift+3 { move-column-to-workspace 3; }
    Mod+Shift+4 { move-column-to-workspace 4; }
    Mod+Shift+5 { move-column-to-workspace 5; }
    Mod+Shift+6 { move-column-to-workspace 6; }
    Mod+Shift+7 { move-column-to-workspace 7; }
    Mod+Shift+8 { move-column-to-workspace 8; }
    Mod+Shift+9 { move-column-to-workspace 9; }

    Mod+WheelScrollDown     cooldown-ms=150 { focus-workspace-down; }
    Mod+WheelScrollUp       cooldown-ms=150 { focus-workspace-up; }
    Mod+WheelScrollRight    cooldown-ms=150 { focus-column-right; }
    Mod+WheelScrollLeft     cooldown-ms=150 { focus-column-left; }

    Mod+TouchpadScrollDown  cooldown-ms=150 { focus-workspace-down; }
    Mod+TouchpadScrollUp    cooldown-ms=150 { focus-workspace-up; }
    Mod+TouchpadScrollRight cooldown-ms=150 { focus-column-right; }
    Mod+TouchpadScrollLeft  cooldown-ms=150 { focus-column-left; }

    // --- Window Management (niri defaults) ---
    Mod+F                { maximize-column; }
    Mod+Shift+F          { fullscreen-window; }
    Mod+Alt+Ctrl+Shift+F { toggle-windowed-fullscreen; }
    Mod+X           { close-window; }
    Mod+Shift+Space { toggle-window-floating; }
    Mod+Space       { toggle-overview; }

    // --- Layout (niri defaults) ---
    Mod+R { switch-preset-column-width; }
    Mod+Alt+R { switch-preset-column-width-back; }
    Mod+Shift+R { switch-preset-window-height; }
    Mod+M { maximize-window-to-edges; }

    // --- Column Management (niri defaults) ---
    Mod+Comma  { consume-window-into-column; }
    Mod+Period { expel-window-from-column; }
    Mod+BracketLeft  { consume-or-expel-window-left; }
    Mod+BracketRight { consume-or-expel-window-right; }
    Mod+C       { center-column; }

    // --- Screenshot (niri defaults) ---
    Print      { screenshot; }
    Ctrl+Print { screenshot-screen; }
    Alt+Print  { screenshot-window; }

    // --- Session (niri defaults) ---
    Mod+Escape allow-inhibiting=false { toggle-keyboard-shortcuts-inhibit; }
    Mod+Ctrl+Shift+Alt+Q { quit; }
    Mod+Ctrl+Shift+Alt+M { power-off-monitors; }
    Mod+Ctrl+Shift+Alt+H hotkey-overlay-title="hibernate"   { spawn "loginctl" "hibernate"; }
    Mod+Ctrl+Shift+Alt+L hotkey-overlay-title="lock screen" { spawn "swaylock" "-c" "000000"; }
    Mod+Ctrl+Shift+Alt+O hotkey-overlay-title="shutdown"    { spawn "loginctl" "poweroff"; }
    Mod+Ctrl+Shift+Alt+S hotkey-overlay-title="suspend"     { spawn "loginctl" "suspend"; }

    // --- Workspaces (niri defaults) ---
    Mod+Shift+0 { move-column-to-workspace 0; }

    // --- Monitor Focus ---
    Mod+W            { focus-monitor-up; }
    Mod+Shift+W      { move-column-to-monitor-up; }
    Mod+E            { focus-monitor-down; }
    Mod+Ctrl+Shift+E { move-column-to-monitor-down; }

    // --- Layout/Resize ---
    Mod+Y       { expand-column-to-available-width; }
    Mod+Shift+Y { set-column-width "-5%"; }
    Mod+Shift+I { set-column-width "+5%"; }

    // --- Column Management ---
    Mod+T                    { toggle-column-tabbed-display; }
    Mod+Ctrl+Up              { move-window-up; }
    Mod+Ctrl+Down            { move-window-down; }
    Mod+Ctrl+Shift+Alt+Right { move-column-to-monitor-right; }
    Mod+Ctrl+Shift+Alt+Left  { move-column-to-monitor-left; }
    Mod+Ctrl+Alt+Right       { focus-monitor-right; }
    Mod+Ctrl+Alt+Left        { focus-monitor-left; }

    // --- Column/Window Focus ---
    Mod+Home       { focus-column-first; }
    Mod+End        { focus-column-last; }
    Mod+Shift+Home { focus-window-top; }
    Mod+Shift+End  { focus-window-bottom; }
}
