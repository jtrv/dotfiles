(defalias

  ;;  home-row tap-holds
  ;;  idx   mid  ring  pink
  ;;  shft  ctl  alt   meta
  ;;
  ;;             ttime  htime  tap  hold
  a   (tap-hold  200    150    a    met)
  s   (tap-hold  200    150    s    alt)
  d   (tap-hold  200    150    d    ctl)
  f   (tap-hold  200    150    f    sft)
  j   (tap-hold  200    150    j    sft)
  k   (tap-hold  200    150    k    ctl)
  l   (tap-hold  200    150    l    alt)
  ;   (tap-hold  200    150    ;    met)

  ;; pinky relief meta tap-holds
  e   (tap-hold  200    175    e    met)
  i   (tap-hold  200    175    i    met)

  ;; hold spc for space layer
  spc (tap-hold  200    150    spc  (layer-while-held space))

  ;; xcape
  esc (tap-hold  200    150    esc  ctl)

  ;; playerctl controls
  mpp (cmd playerctl play-pause)
  mpr (cmd playerctl previous)
  mnx (cmd playerctl next)

  ;; scroll volume
  svlu (cmd wpctl set-volume @DEFAULT_AUDIO_SINK@ 1%+)
  svld (cmd wpctl set-volume @DEFAULT_AUDIO_SINK@ 1%-)

  ;; key volume
  kvlu (tap-hold 200    200    @svlu  (macro-repeat @svlu 50))
  kvld (tap-hold 200    200    @svld  (macro-repeat @svld 50))
)

(defchordsv2
  (f j)   (caps-word 5000)                        50 first-release ()

  (s d)   (tap-hold 200 150 esc (multi alt ctl))  50 first-release ()
  (w e)   tab                                     50 first-release ()
  (q w)   home                                    50 first-release ()

  (k l)   (tap-hold 200 150 ret (multi ctl alt))  50 first-release ()
  (i o)   bspc                                    50 first-release ()
  (l ;)   (tap-hold 200 150 del (multi alt met))  50 first-release ()
  (o p)   end                                     50 first-release ()

  (met mmid)  @mpp                               50 first-release ()
)
