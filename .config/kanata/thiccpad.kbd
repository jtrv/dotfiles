(defcfg
  concurrent-tap-hold yes
  danger-enable-cmd yes
  linux-dev-names-include (
    "AT Translated Set 2 keyboard"
    "Elan TrackPoint"
  )
)

(deflocalkeys-linux
  fav  164
  tls  179
  dsp  235
  blt  245
  wln  246
  mmut 248
)

(defsrc
   esc   mute  vold  volu  mmut  brdn  brup  dsp   wln   tls   blt   fav   home  end  ins  del
   grv   1     2     3     4     5     6     7     8     9     0     -     =     bspc
   tab   q     w     e     r     t     y     u     i     o     p     [     ]     \
   caps  a     s     d     f     g     h     j     k     l     ;     '     ret
   lsft  z     x     c     v     b     n     m     ,     .     /     rsft
   lctl  lmet  lalt             spc                ralt  prnt  rctl  pgup  up    pgdn
                                                                     lft   down  rght
   ;; mouse
   mlft  mmid  mrgt  mwu   mwd   mwl   mwr   mbck  mfwd
)

(include shared.kbd)

(deflayer base
   esc   mute  vold  volu  mmut  brdn  brup  dsp   wln   tls   blt   fav   home  end   ins  del
   grv   1     2     3     @4    5     6     7     8     9     0     -     =     bspc
   tab   q     w     @e    r     t     y     u     @i    o     p     [     ]     \
   @esc  @a    @s    @d    @f    @gam  h     @j    @k    @l    @;    '     ret
   sft   z     x     c     v     b     n     m     ,     .     /     sft
   ctl   met   alt              @spc               alt   prnt  ctl   pgup  up    pgdn
                                                                     lft   down  rght
   ;; mouse
   mlft  mmid  mrgt  mwu   mwd   mwl   mwr   mbck  mfwd
)

(deflayer space
   _     _     _     _     _     _     _     _     _     _     _     _     _     _     _     _
   _     _     _     _     _     _     _     _     _     _     _     _     _     _
   _     _     @kvld @kvlu _     _     _     bspc  home  end   del   _     _     _
   _     @mpr  _     @mpp  @mnx  _     left  down  up    rght  _     _     _
   _     _     _     _     _     _     _     _     pgdn  pgup  _     _
   _     _     _                 _                 _     _     _     _     _     _
                                                                     _     _     _
   ;;  mouse
   _     @mpp  _     @svlu  @svld  _     _     _     _
)

;; No tap-holds: a held wasd/f key must repeat, not fire a modifier.
;; Chords are disabled here via defchordsv2's disabled-layers in shared.kbd.
(deflayer gaming
   esc   mute  vold  volu  mmut  brdn  brup  dsp   wln   tls   blt   fav   home  end   ins  del
   grv   1     2     3     4     5     6     7     8     9     0     -     =     bspc
   tab   q     w     e     r     t     y     u     i     o     p     [     ]     \
   @esc  a     s     d     f     @gam  h     @j    @k    @l    @;    '     ret
   lsft  z     x     c     v     b     n     m     ,     .     /     rsft
   lctl  lmet  lalt             spc                ralt  prnt  rctl  pgup  up    pgdn
                                                                     lft   down  rght
   ;; mouse
   mlft  mmid  mrgt  mwu   mwd   mwl   mwr   mbck  mfwd
)
