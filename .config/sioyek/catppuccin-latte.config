# === CATPPUCCIN LATTE ===

# Page surround (normal mode) and the page itself in custom-colour mode.
background_color                        #e6e9ef
custom_background_color                 #eff1f5
custom_text_color                       #4c4f69
custom_color_mode_empty_background_color #e6e9ef
dark_mode_background_color              #eff1f5
page_separator_color                    #ccd0da

# ui_background_color is registered twice in config.cpp, the second binding
# writing STATUS_BAR_COLOR - so it must stay equal to status_bar_color.
ui_text_color                           #4c4f69
ui_background_color                     #ccd0da
ui_selected_text_color                  #4c4f69
ui_selected_background_color            #acb0be
status_bar_color                        #ccd0da
status_bar_text_color                   #4c4f69

# Overlays sioyek paints over the page.
text_highlight_color                    #df8e1d
search_highlight_color                  #fe640b
unselected_search_highlight_color       #acb0be
link_highlight_color                    #1e66f5
link_destination_highlight_color        #7287fd
synctex_highlight_color                 #40a02b
freetext_bookmark_color                 #8839ef
ruler_color                             #bcc0cc
ruler_marker_color                      #d20f39

# add_color4 entries: four floats 0.0-1.0, hex is rejected here.
visual_mark_color                       0.549 0.561 0.631 0.20
keyboard_select_background_color        0.118 0.400 0.961 0.35
keyboard_select_text_color              0.298 0.310 0.412 1.00
keyboard_selected_tag_background_color  0.996 0.392 0.043 0.90
keyboard_selected_tag_text_color        0.863 0.878 0.910 1.00

# Highlight types a-z, chosen with add_highlight <letter>. a-n are the 14
# accents, o-z the same hues blended halfway to surface0 for a quieter twin.
# The colour parser reads the whole line, so these cannot carry inline comments.
#   a yellow  b green   c sky      d maroon   e mauve    f red      g peach
#   h teal    i blue    j sapphire k lavender l pink     m flamingo n rosewater
#   o yellow  p green   q sky      r maroon   s mauve    t red      u peach
#   v teal    w blue    x lavender y pink     z rosewater      (o-z all muted)
highlight_color_a  #df8e1d
highlight_color_b  #40a02b
highlight_color_c  #04a5e5
highlight_color_d  #e64553
highlight_color_e  #8839ef
highlight_color_f  #d20f39
highlight_color_g  #fe640b
highlight_color_h  #179299
highlight_color_i  #1e66f5
highlight_color_j  #209fb5
highlight_color_k  #7287fd
highlight_color_l  #ea76cb
highlight_color_m  #dd7878
highlight_color_n  #dc8a78

highlight_color_o  #d6af7c
highlight_color_p  #86b882
highlight_color_q  #68bbe0
highlight_color_r  #d98a96
highlight_color_s  #aa84e4
highlight_color_t  #cf708a
highlight_color_u  #e59a72
highlight_color_v  #72b1ba
highlight_color_w  #759be8
highlight_color_x  #9facec
highlight_color_y  #dba3d2
highlight_color_z  #d4ada9
