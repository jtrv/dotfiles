# === CATPPUCCIN MOCHA ===

# Page surround (normal mode) and the page itself in custom-colour mode.
background_color                        #181825
custom_background_color                 #1e1e2e
custom_text_color                       #cdd6f4
custom_color_mode_empty_background_color #181825
dark_mode_background_color              #1e1e2e
page_separator_color                    #313244

# ui_background_color is registered twice in config.cpp, the second binding
# writing STATUS_BAR_COLOR - so it must stay equal to status_bar_color.
ui_text_color                           #cdd6f4
ui_background_color                     #313244
ui_selected_text_color                  #cdd6f4
ui_selected_background_color            #585b70
status_bar_color                        #313244
status_bar_text_color                   #cdd6f4

# Overlays sioyek paints over the page.
text_highlight_color                    #f9e2af
search_highlight_color                  #fab387
unselected_search_highlight_color       #585b70
link_highlight_color                    #89b4fa
link_destination_highlight_color        #b4befe
synctex_highlight_color                 #a6e3a1
freetext_bookmark_color                 #cba6f7
ruler_color                             #45475a
ruler_marker_color                      #f38ba8

# add_color4 entries: four floats 0.0-1.0, hex is rejected here.
visual_mark_color                       0.498 0.518 0.612 0.20
keyboard_select_background_color        0.537 0.706 0.980 0.35
keyboard_select_text_color              0.804 0.839 0.957 1.00
keyboard_selected_tag_background_color  0.980 0.702 0.529 0.90
keyboard_selected_tag_text_color        0.067 0.067 0.106 1.00

# Highlight types a-z, chosen with add_highlight <letter>. a-n are the 14
# accents, o-z the same hues blended halfway to surface0 for a quieter twin.
# The colour parser reads the whole line, so these cannot carry inline comments.
#   a yellow  b green   c sky      d maroon   e mauve    f red      g peach
#   h teal    i blue    j sapphire k lavender l pink     m flamingo n rosewater
#   o yellow  p green   q sky      r maroon   s mauve    t red      u peach
#   v teal    w blue    x lavender y pink     z rosewater      (o-z all muted)
highlight_color_a  #f9e2af
highlight_color_b  #a6e3a1
highlight_color_c  #89dceb
highlight_color_d  #eba0ac
highlight_color_e  #cba6f7
highlight_color_f  #f38ba8
highlight_color_g  #fab387
highlight_color_h  #94e2d5
highlight_color_i  #89b4fa
highlight_color_j  #74c7ec
highlight_color_k  #b4befe
highlight_color_l  #f5c2e7
highlight_color_m  #f2cdcd
highlight_color_n  #f5e0dc

highlight_color_o  #958a7a
highlight_color_p  #6c8a72
highlight_color_q  #5d8798
highlight_color_r  #8e6978
highlight_color_s  #7e6c9e
highlight_color_t  #925e76
highlight_color_u  #967266
highlight_color_v  #628a8c
highlight_color_w  #5d739f
highlight_color_x  #7278a1
highlight_color_y  #937a96
highlight_color_z  #938990
