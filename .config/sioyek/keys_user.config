# sioyek keybindings.
#
# Layout follows kakoune where sioyek has an equivalent concept, vim where it does
# not, then common norms, then mnemonics. Sequences are a flat prefix tree with no
# modes, so a bare key shadows every longer sequence starting with it - `gp` and
# `gph` cannot both exist. Duplicates do not error either: the LAST binding for a
# key silently wins, which is what broke hjkl in the previous version of this file.
#
# Shift is written as the uppercase key. <C-S-l> is the old syntax and is rejected;
# write <C-L>.

# ---------- MOVEMENT ----------
move_left                   h
move_down                   j
move_up                     k
move_right                  l

screen_down                 <C-d>
screen_up                   <C-u>
next_page                   <C-f>
previous_page               <C-b>
screen_down                 <pagedown>
screen_up                   <pageup>

# ---------- GOTO ----------
# kakoune's g menu: gk/gj buffer ends, gh/gl line ends, gt/gb window ends, ga alternate.
goto_beginning              gg
goto_beginning              gk
goto_end                    gj
goto_end                    ge
goto_left                   gh
goto_right                  gl
goto_left_smart             gH
goto_right_smart            gL
goto_top_of_page            gt
goto_bottom_of_page         gb
open_last_document          ga
goto_definition             gd
portal_to_definition        gD
goto_page_with_page_number  gp
goto_page_with_label        gP
goto_window                 gw
goto_selected_text          gs
goto_random_page            gr

# vim's z view keys. zz keeps the top-right of the page in view, which is where a
# two-column paper continues after the left column ends.
goto_top_of_page;goto_right_smart   zz
goto_top_of_page            zt
goto_bottom_of_page         zb

# vim's jumplist. <C-o>/<C-i> are the norm; <C-k>/<C-j> stay as the older aliases.
prev_state                  <C-o>
next_state                  <C-i>
prev_state                  <C-k>
next_state                  <C-j>

# ---------- NEXT / PREVIOUS ----------
# vim-unimpaired's ] and [ pairs.
next_chapter                ]c
prev_chapter                [c
goto_next_highlight         ]h
goto_prev_highlight         [h
goto_next_highlight_of_type ]H
goto_prev_highlight_of_type [H
goto_next_tab               ]t
goto_prev_tab               [t

# ---------- LISTS ----------
# kakoune's , user mode. <space> is left alone so it keeps scrolling a screen.
goto_toc                    t
goto_toc                    ,t
goto_bookmark               ,b
goto_bookmark_g             ,B
goto_highlight              ,h
goto_highlight_g            ,H
goto_portal_list            ,p
show_marks                  ,m
open_prev_doc               ,d
goto_tab                    ,w
command_palette             ,,

# ---------- SEARCH ----------
search                      /
regex_search                ?
chapter_search              c/
next_item                   n
previous_item               N
select_current_search_match <A-n>
# Chosen with s then the letter of a search_url_* entry in prefs_user.config.
external_search             s
open_selected_url           <A-o>

# ---------- DOCUMENTS ----------
open_document               o
open_prev_doc               O
open_document_embedded      ,e
open_document_embedded_from_current_path    ,E
new_window                  <C-n>
close_window                q
quit                        <C-q>
reload_config               <C-r>
repeat_last_command         .
command                     :

# ---------- ZOOM AND FIT ----------
zoom_in                     <C-l>
zoom_out                    <C-h>
zoom_in_cursor              <C-L>
zoom_out_cursor             <C-H>
rotate_clockwise            r
rotate_counterclockwise     R
fit_to_page_width           -
fit_to_page_width_smart     _
fit_to_page_height          =
fit_to_page_height_smart    +
fit_to_page_width_ratio     0
fit_to_page_smart           )

# ---------- SELECTION ----------
# v/V/<C-v> mirror vim's characterwise, linewise and blockwise visual modes.
enter_visual_mark_mode      v
keyboard_select             V
select_rect                 <C-v>
close_visual_mark           <A-v>
move_visual_mark_up         <up>
move_visual_mark_down       <down>
move_visual_mark_prev       <A-k>
move_visual_mark_next       <A-j>
copy                        y
copy_all_text               Y
copy_link                   <A-y>
copy_screenshot_to_clipboard    <C-y>

# vimium's f follows a link; F is sioyek's fuzzier jump to a reference.
open_link                   f
keyboard_smart_jump         F
keyboard_overview           <A-f>

# ---------- MARKS AND BOOKMARKS ----------
set_mark                    m
goto_mark                   `
add_bookmark                b
add_freetext_bookmark       B
delete_bookmark             db

# ---------- HIGHLIGHTS ----------
add_highlight               H
add_highlight_with_current_type     <A-h>
toggle_select_highlight     <A-H>
change_highlight            ch
set_select_highlight_type   ct
delete_highlight            dh
delete_highlight_under_cursor       dH

# ---------- PORTALS ----------
portal                      p
edit_portal                 P
delete_portal               dp
goto_portal                 <tab>
edit_portal                 <S-<tab>>
toggle_window_configuration <f12>

# ---------- OVERVIEW ----------
overview_definition         <A-e>
overview_under_cursor       <A-u>
close_overview              <A-c>
portal_to_overview          <A-C>

# ---------- TOGGLES ----------
toggle_dark_mode            <A-d>
toggle_custom_color         <A-x>
toggle_synctex              <A-s>
synctex_under_cursor        <A-/>
toggle_mouse_drag_mode      <A-m>
toggle_visual_scroll        <f7>
toggle_presentation_mode    <A-p>
toggle_fullscreen           <f11>
toggle_statusbar            <A-b>
toggle_scrollbar            <A-B>
toggle_titlebar             <A-t>
toggle_highlight            <A-l>
toggle_two_page_mode        <A-2>
toggle_smooth_scroll_mode   <A-,>
toggle_fastread             <A-r>
toggle_pdf_annotations      <A-a>
toggle_horizontal_scroll_lock       <A-z>
toggle_reading              <A-.>
