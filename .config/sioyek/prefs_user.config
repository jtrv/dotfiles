# ---------- THEME ----------
# Follow the desktop light/dark preference (Qt reads org.freedesktop.appearance
# color-scheme from the portal). Dark resolves to custom-colour mode instead of
# sioyek's colour inversion, so pages get the catppuccin base/text below.
# Only works when launched through ~/.local/bin/sioyek: the session-wide
# QT_QPA_PLATFORMTHEME=qt6ct makes Qt report ColorScheme::Unknown, and neither
# branch of set_color_mode_to_system_theme fires on Unknown.
# Do not put toggle_custom_color back into startup_commands: startup_commands run
# after the system-theme hook and would toggle custom colour straight back off.
use_system_theme 1
use_custom_color_as_dark_system_theme 1

# Chrome, overlays and the highlight palette. Read once at startup - sioyek has no
# command that repaints these, so switching palettes needs a restart.
source /home/sugimoto/.config/sioyek/catppuccin-mocha.config

preserve_image_colors_in_dark_mode 1
adjust_annotation_colors_for_dark_mode 1

# ---------- SEARCH ----------
# Indexes document text, which is also what regex_search needs.
super_fast_search 1
smartcase_search 1
incremental_search 1
should_highlight_unselected_search 1

# ---------- UI ----------
ui_font BlexMono Nerd Font
collapsed_toc 1
page_labels_in_table_of_contents 1
show_doc_path 1
show_document_name_in_statusbar 1
show_closest_bookmark_in_statusbar 1
show_command_hints 1
right_click_context_menu 1
wheel_zoom_on_cursor 1
sort_highlights_by_location 1

# ---------- EXTERNAL SEARCH ----------
# Picked with external_search (s) followed by the letter.
search_url_a https://arxiv.org/abs/
search_url_d https://duckduckgo.com/?q=
search_url_w https://en.wikipedia.org/w/index.php?search=
search_url_g https://www.google.com/search?q=
search_url_s https://scholar.google.com/scholar?q=
