#!/bin/sh
# requires curl, jq, rg, sd, ipinfo.io token

bold=$(tput bold)
normal=$(tput sgr0)

ipinfo_token=$(cat /run/agenix/ipinfo-token)

coordinates=$(curl -fsSL "https://ipinfo.io/?token=$ipinfo_token" | jq -r '.loc')

forecast_url=$(curl -fsSL "https://api.weather.gov/points/$coordinates" | jq -r '.properties.forecast')

curl -fsSL "$forecast_url" |
  jq -c '.properties.periods[] | {name, detailedForecast}' |
  rg --color=never -o 'name":"(.*?)","detailedForecast":"(.*?)"' -r "
$bold\$1:$normal \$2" |
  sd -f i 'with | with a| as high as| around| near' '' |
  sd -f i 'north' 'N' |
  sd -f i 'south' 'S' |
  sd -f i 'east' 'E' |
  sd -f i 'west' 'W' |
  sd -f i ' to ' '-' |
  sd -f m '\n.*?(Night|Tonight)' "${bold}\$1" |
  rg '(N|S|E|W) (NW|NE|SE|SW)' -r '$1/$2' --color=never --passthru
