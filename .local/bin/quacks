#!/usr/bin/env bash
# Runs games packed as a DwarFS image (files/game-root.dwarfs) plus a writable
# overlay (files/overlay-storage), inside a bubblewrap sandbox.
#
#   quacks run <game dir> [variant] [-- game args]
#   quacks mount|unmount|check|compress <game dir>
#   quacks setup    install umu's runtime: copied from a runtime= path when one
#                   exists, otherwise fetched for the configured Proton (network)
#
# Settings come from ~/.config/quacks/config, then <game dir>/quacks.conf:
# key=value lines, # comments, and [variant] sections that override the keys
# above them. Keys:
#   exe        program to run, relative to dir (required for run)
#   dir        subfolder of the game files to run from
#   runner     wine (default) or native
#   gameid     Steam app id, selects the game's ProtonFixes
#   dlls       extra WINEDLLOVERRIDES entries
#   args       extra arguments for exe, split on spaces
#   env        KEY=VALUE exported to the game; repeatable
#   proton     Proton installs umu-run may use, space-separated; first found wins
#   runtime    prebuilt umu runtime dirs (holding steamrt4/), first found wins;
#              run copies it in when the installed one is missing or differs
#   isolate    1 runs the game in the sandbox
#   block_net  1 cuts the sandbox off from the network
set -u

DATA="${XDG_DATA_HOME:-$HOME/.local/share}/quacks"
CONFIG="${XDG_CONFIG_HOME:-$HOME/.config}/quacks/config"
KEYS=" exe dir runner gameid dlls args env proton runtime isolate block_net "

die() { echo "quacks: $*" >&2; exit 1; }

declare -A CONF=( [runner]=wine [isolate]=1 [block_net]=1 )
ENVS=()

# load <file> [variant]: keys before any section always apply; a section
# applies only when it names the requested variant.
load() {
    local file=$1 want=${2:-} section= found= line key val
    [ -f "$file" ] || return 0
    while IFS= read -r line || [ -n "$line" ]; do
        [[ $line =~ ^[[:space:]]*(#|$) ]] && continue
        if [[ $line =~ ^\[(.+)\]$ ]]; then
            section=${BASH_REMATCH[1]}
            [ "$section" = "$want" ] && found=1
            continue
        fi
        [ -z "$section" ] || [ "$section" = "$want" ] || continue
        key=${line%%=*} val=${line#*=}
        [[ $KEYS == *" $key "* ]] || die "$file: unknown key '$key'"
        if [ "$key" = env ]; then ENVS+=("$val"); else CONF[$key]=$val; fi
    done <"$file"
    [ -z "$want" ] || [ -n "$found" ] || die "$file: no [$want] section"
}

mount_game() {
    unmount_game 2>/dev/null
    local ram cache
    ram=$(awk '/MemTotal/ {print $2}' /proc/meminfo)
    [ "$ram" -gt 24000000 ] && cache=$((ram * 30 / 100)) || cache=$((ram * 15 / 100))
    mkdir -p "$FL/.game-root-mnt" "$FL/overlay-storage" "$FL/.game-root-work" "$FL/game-root"
    dwarfs "$FL/game-root.dwarfs" "$FL/.game-root-mnt" -o cachesize="${cache}k" -o clone_fd &&
    fuse-overlayfs -o squash_to_uid="$(id -u)" -o squash_to_gid="$(id -g)" \
        -o lowerdir="$FL/.game-root-mnt",upperdir="$FL/overlay-storage",workdir="$FL/.game-root-work" \
        "$FL/game-root"
}

unmount_game() {
    fuser -k "$FL/.game-root-mnt" >/dev/null 2>&1
    fusermount3 -u -z "$FL/game-root" 2>/dev/null
    fusermount3 -u -z "$FL/.game-root-mnt" 2>/dev/null
    rm -rf "$FL/.game-root-mnt" "$FL/.game-root-work"
    rmdir "$FL/game-root" 2>/dev/null
    return 0
}

# Read-only system with the user's data hidden: an empty home, /run/user
# reduced to the audio sockets and X cookie, X limited to the game's own
# display, no other drives, and a /dev holding only the GPU and gamepads
# (quacks-hotplug adds and removes those while the game runs). Writable are
# the mounted game files, the prefix (or the native games' home) and a
# private /tmp.
sandbox() {
    local run="/run/user/$(id -u)" flags dev path entry info status
    flags=(
        --ro-bind / / --proc /proc
        --dev /dev --dev-bind /dev/dri /dev/dri --tmpfs /dev/shm --dir /dev/input
        --tmpfs /tmp --tmpfs "$run" --tmpfs /run/dbus
    )
    # X also listens on abstract sockets, which only --unshare-net cuts off
    if [[ ${DISPLAY:-} =~ ^:([0-9]+) ]]; then
        path=/tmp/.X11-unix/X${BASH_REMATCH[1]}
        [ -S "$path" ] && flags+=( --ro-bind "$path" "$path" )
    fi
    for path in "$run/pipewire-0" "$run/pulse/native" "${XAUTHORITY:-}"; do
        [ -e "$path" ] && flags+=( --ro-bind "$path" "$path" )
    done
    for path in /mnt /srv /media /run/media; do
        [ -d "$path" ] && flags+=( --tmpfs "$path" )
    done
    for dev in /dev/input/js* /dev/input/event*; do
        udevadm info -q property -n "$dev" 2>/dev/null | grep -qx 'ID_INPUT_JOYSTICK=1' &&
            flags+=( --dev-bind "$dev" "$dev" )
    done
    if [ "${CONF[runner]}" = native ]; then
        mkdir -p "$DATA/native-docs"
        # binds below land inside this one, so it has to come first
        flags+=( --bind "$DATA/native-docs" "$HOME" )
    else
        # umu writes its shim, lock and install marker here and pressure-vessel
        # locks the platform's .ref, so the runtime is rebuilt on the tmpfs home
        # from read-only binds of its entries. Binds, unlike an overlay, keep it
        # on the prefix's filesystem, so pressure-vessel's ~570 MB per-prefix
        # copy of it is a reflink.
        path=$UMU/steamrt4
        [ -d "$path" ] || die "no umu runtime yet: run quacks setup"
        flags+=( --tmpfs "$HOME" --dir "$path" --file 8 "$path/.installed.ok" )
        for entry in "$path"/*; do
            if [ -L "$entry" ]; then
                flags+=( --symlink "$(readlink "$entry")" "$entry" )
            else
                flags+=( --ro-bind "$entry" "$entry" )
            fi
        done
        # after the binds above, which it lands inside
        for entry in "$path"/steamrt4_platform_*/files/.ref; do
            flags+=( --bind-data 9 "$entry" )
        done
        flags+=( --bind "$WINEPREFIX" "$WINEPREFIX" )
    fi
    flags+=( --bind "$ROOT_MNT" "$ROOT_MNT" --chdir "$RUN_DIR" )
    # IPC stays shared: X's MIT-SHM needs it to talk to the X server.
    # udev events can't reach the sandbox, so SDL has to spot gamepads that
    # quacks-hotplug adds by watching /dev/input itself.
    flags+=( --unshare-pid --unshare-uts --unshare-cgroup-try --new-session
             --die-with-parent --cap-drop ALL --unsetenv DBUS_SESSION_BUS_ADDRESS
             --setenv SDL_JOYSTICK_DISABLE_UDEV 1 )
    [ "${CONF[block_net]}" = 1 ] && flags+=( --unshare-net )
    info=$(mktemp)
    # disabled: a game can make it unmount the sandbox masks (see quacks-hotplug review)
    :     "${BASH_SOURCE%/*}/quacks-hotplug" "$info" &
    bwrap --info-fd 3 "${flags[@]}" "$@" 3>"$info" 8<<<ok 9</dev/null
    status=$?
    rm -f "$info"
    return $status
}

find_proton() {
    local proton
    # resolved: nixpkgs' umu-run is an FHS env with its own /etc, so a
    # symlink like /etc/quacks/proton points at nothing inside it
    for proton in ${CONF[proton]:-}; do
        [ -d "$proton" ] && { readlink -f "$proton"; return; }
    done
    die "none of the proton paths in $CONFIG exist"
}

UMU="${XDG_DATA_HOME:-$HOME/.local/share}/umu"

find_runtime() {
    local runtime
    for runtime in ${CONF[runtime]:-}; do
        [ -d "$runtime/steamrt4" ] && { echo "$runtime"; return; }
    done
    return 1
}

# umu and pressure-vessel write into the runtime (install marker, .ref locks),
# so a read-only one (a Nix store path) has to be copied into a user-owned dir
copy_runtime() {
    local src=$1 tmp
    cmp -s "$src/steamrt4/VERSIONS.txt" "$UMU/steamrt4/VERSIONS.txt" && return 0
    echo "quacks: installing umu runtime from $src" >&2
    mkdir -p "$UMU"
    tmp=$(mktemp -d "$UMU/.steamrt4.XXXXXX")
    cp -a --reflink=auto "$src/steamrt4/." "$tmp/" && chmod -R u+w "$tmp" || { rm -rf "$tmp"; return 1; }
    rm -rf "$UMU/steamrt4"
    mv "$tmp" "$UMU/steamrt4"
}

# The sandbox can't download, so umu's runtime is fetched here, outside it,
# by booting a throwaway prefix: Proton's own code runs, no game does.
setup_runtime() {
    local proton runtime tmp
    if runtime=$(find_runtime); then
        copy_runtime "$runtime"
        return
    fi
    proton=$(find_proton) || exit 1
    tmp=$(mktemp -d)
    WINEPREFIX="$tmp" PROTONPATH="$proton" GAMEID=umu-default umu-run wineboot -u
    rm -rf "$tmp"
}

run_game() {
    local variant=${1:-}
    [ "$variant" = -- ] && variant=
    [ $# -gt 0 ] && shift
    [ "${1:-}" = -- ] && shift
    load "$GAME/quacks.conf" "$variant"
    [ -n "${CONF[exe]:-}" ] || die "$GAME/quacks.conf: no exe"

    trap unmount_game EXIT
    mount_game || die "mounting $FL/game-root.dwarfs failed"
    trap 'exit 130' INT TERM

    ROOT_MNT="$FL/game-root"
    RUN_DIR="$ROOT_MNT${CONF[dir]:+/${CONF[dir]}}"
    local args=() cmd
    read -ra args <<<"${CONF[args]:-}"

    if [ "${CONF[runner]}" = native ]; then
        cmd=( "./${CONF[exe]}" )
    else
        local proton runtime
        proton=$(find_proton) || exit 1
        if runtime=$(find_runtime); then
            copy_runtime "$runtime" || die "copying the umu runtime from $runtime failed"
        fi
        export WINEPREFIX="$DATA/wine-prefix/$(basename "$GAME")"
        mkdir -p "$WINEPREFIX"
        # The sandbox keeps $HOME read-only, so umu must use a local Proton,
        # skip its runtime updates, and cache (pressure-vessel's runtime copy
        # included) inside the bound prefix.
        export PROTONPATH="$proton" UMU_RUNTIME_UPDATE=0 XDG_CACHE_HOME="$WINEPREFIX/.cache"
        export PRESSURE_VESSEL_VARIABLE_DIR="$WINEPREFIX/.cache/pressure-vessel"
        export WINEDLLOVERRIDES="winemenubuilder.exe=d;mshtml=d${CONF[dlls]:+;${CONF[dlls]}}"
        export WINE_LARGE_ADDRESS_AWARE=1 WINEDEBUG=fixme-all
        [ -n "${CONF[gameid]:-}" ] && export GAMEID="umu-${CONF[gameid]}"
        cmd=( umu-run "${CONF[exe]}" )
    fi
    local e
    for e in "${ENVS[@]}"; do export "$e"; done

    if [ "${CONF[isolate]}" = 1 ]; then
        sandbox "${cmd[@]}" "${args[@]}" "$@"
    else
        (cd "$RUN_DIR" && "${cmd[@]}" "${args[@]}" "$@")
    fi
}

[ "$EUID" = 0 ] && die "refusing to run as root"
for dep in dwarfs fuse-overlayfs bwrap; do
    command -v "$dep" >/dev/null || die "$dep not installed"
done

action=${1:-}
if [ "$action" = setup ]; then
    load "$CONFIG"
    setup_runtime
    exit
fi
[ $# -ge 2 ] || die "usage: quacks run|mount|unmount|check|compress <game dir> [variant] [-- args], or quacks setup"
GAME=$(readlink -f "$2")
FL="$GAME/files"
shift 2
load "$CONFIG"

case $action in
    run) run_game "$@" ;;
    mount) mount_game ;;
    unmount) unmount_game ;;
    check) dwarfsck --check-integrity -i "$FL/game-root.dwarfs" ;;
    compress)
        [ ! -e "$FL/game-root.dwarfs" ] || die "$FL/game-root.dwarfs already exists"
        mkdwarfs -l7 -B26 -S26 --no-create-timestamp --order=nilsimsa \
            -i "$FL/game-root" -o "$FL/game-root.dwarfs"
        ;;
    *) die "unknown action '$action'" ;;
esac
