#!/usr/bin/env bash
# Runs games packed as a DwarFS image (files/game-root.dwarfs) plus a writable
# overlay (files/overlay-storage), inside a bubblewrap sandbox.
#
#   quacks run <game dir> [variant] [-- game args]
#   quacks mount|unmount|check|compress <game dir>
#   quacks setup    fetch umu's runtime for the configured Proton (needs network)
#
# Settings come from ~/.config/quacks/config, then <game dir>/quacks.conf:
# key=value lines, # comments, and [variant] sections that override the keys
# above them. Keys:
#   exe        program to run, relative to dir (required for run)
#   dir        subfolder of the game files to run from
#   runner     wine (default) or native
#   gameid     Steam app id, selects the game's ProtonFixes
#   dlls       extra WINEDLLOVERRIDES entries
#   args       extra arguments for exe, split on spaces
#   env        KEY=VALUE passed to the game; repeatable
#   proton     Proton installs umu-run may use, space-separated; first found wins
#   block_net  0 lets the game reach the network (default 1)
set -u

DATA="${XDG_DATA_HOME:-$HOME/.local/share}/quacks"
CONFIG="${XDG_CONFIG_HOME:-$HOME/.config}/quacks/config"
KEYS=" exe dir runner gameid dlls args env proton block_net "
# The host environment carries API tokens and dev tool paths; the game gets
# only what graphics, audio, Wine and Lutris's wrappers read.
KEEP_ENV='^(HOME|USER|LOGNAME|LANG|LANGUAGE|LC_[A-Z]+|TZ|TERM|DISPLAY|XAUTHORITY|XDG_[A-Z_]+|LOCALE_ARCHIVE|PULSE_SERVER|PIPEWIRE_[A-Z_]+|SDL_[A-Z0-9_]+|WINE[A-Z_]*|PROTON[A-Z_]*|UMU_[A-Z_]+|GAMEID|STORE|PRESSURE_VESSEL_[A-Z_]+|DXVK_[A-Z_]+|VKD3D_[A-Z_]+|MESA_[A-Z_]+|RADV_[A-Z_]+|AMD_[A-Z_]+|VK_[A-Z_]+|__GL_[A-Z_]+|__GLX_[A-Z_]+|__EGL_[A-Z_]+|LIBGL_[A-Z_]+|GST_[A-Z_]+|ENABLE_[A-Z_]+|GAMESCOPE_[A-Z_]+|MANGOHUD[A-Z_]*|LD_PRELOAD|LD_LIBRARY_PATH)$'

die() { echo "quacks: $*" >&2; exit 1; }

declare -A CONF=( [runner]=wine [block_net]=1 )
ENVS=()

# load <file> [variant]: keys before any section always apply; a section
# applies only when it names the requested variant.
load() {
    local file=$1 want=${2:-} section= found= line key val
    [ -f "$file" ] || return 0
    while IFS= read -r line || [ -n "$line" ]; do
        line=${line%$'\r'}
        [[ $line =~ ^[[:space:]]*(#|$) ]] && continue
        if [[ $line =~ ^\[(.+)\]$ ]]; then
            section=${BASH_REMATCH[1]}
            [ "$section" = "$want" ] && found=1
            continue
        fi
        [ -z "$section" ] || [ "$section" = "$want" ] || continue
        [[ $line == *=* ]] || die "$file: '$line' is not key=value"
        key=${line%%=*} val=${line#*=}
        [[ $KEYS == *" $key "* ]] || die "$file: unknown key '$key'"
        if [ "$key" = env ]; then
            [[ $val =~ ^[A-Za-z_][A-Za-z0-9_]*= ]] || die "$file: env '$val' is not NAME=value"
            ENVS+=("$val")
        else
            CONF[$key]=$val
        fi
    done <"$file"
    [ -z "$want" ] || [ -n "$found" ] || die "$file: no [$want] section"
    [[ ${CONF[block_net]} =~ ^[01]$ ]] || die "$file: block_net must be 0 or 1"
    [[ ${CONF[runner]} =~ ^(wine|native)$ ]] || die "$file: runner must be wine or native"
}

# Held for the whole command, and inherited by the sandbox but not by the FUSE
# daemons, so a second launch can't tear down a running game's mounts while a
# crashed run's leftover mounts still get cleaned up.
lock_game() {
    exec 9>"$FL/.quacks.lock"
    flock -n 9 || die "$GAME is already in use by another quacks"
}

mount_game() {
    unmount_game || return 1
    local ram cache
    ram=$(awk '/MemTotal/ {print $2}' /proc/meminfo)
    [ "$ram" -gt 24000000 ] && cache=$((ram * 30 / 100)) || cache=$((ram * 15 / 100))
    mkdir -p "$FL/.game-root-mnt" "$FL/overlay-storage" "$FL/.game-root-work" "$FL/game-root"
    dwarfs "$FL/game-root.dwarfs" "$FL/.game-root-mnt" -o cachesize="${cache}k" -o clone_fd 9>&- &&
    fuse-overlayfs -o squash_to_uid="$(id -u)" -o squash_to_gid="$(id -g)" \
        -o lowerdir="$FL/.game-root-mnt",upperdir="$FL/overlay-storage",workdir="$FL/.game-root-work" \
        "$FL/game-root" 9>&-
}

# Overlay first, it reads through the image. A busy mount is only detached
# lazily, and then the work dir stays: fuse-overlayfs may still write to it.
unmount_game() {
    local mnt clean=1
    for mnt in "$FL/game-root" "$FL/.game-root-mnt"; do
        findmnt -rn --mountpoint "$mnt" >/dev/null || continue
        fusermount3 -u "$mnt" 2>/dev/null && continue
        echo "quacks: $mnt is busy, detaching it lazily" >&2
        fusermount3 -u -z "$mnt"
        clean=
    done
    [ -n "$clean" ] || return 1
    rm -rf "$FL/.game-root-work"
    rmdir "$FL/.game-root-mnt" "$FL/game-root" 2>/dev/null
    return 0
}

# Read-only system with the user's data hidden: an empty home, /run/user
# reduced to the audio sockets and X cookie, X limited to the game's own
# display, no other drives, a /dev holding only the GPU and the gamepads
# present at launch, and a filtered environment. Writable are the mounted game
# files, the game's prefix or native home, and a private /tmp.
sandbox() {
    local run="/run/user/$(id -u)" flags dev path name e parts paths=()
    flags=(
        --ro-bind / / --proc /proc
        --dev /dev --dev-bind /dev/dri /dev/dri --tmpfs /dev/shm --dir /dev/input
        --tmpfs /tmp --tmpfs "$run" --tmpfs /run/dbus
    )
    for path in /mnt /srv /media /run/media /var/tmp /.snapshots /home; do
        [ -d "$path" ] && flags+=( --tmpfs "$path" )
    done
    for dev in /dev/input/js* /dev/input/event*; do
        udevadm info -q property -n "$dev" 2>/dev/null | grep -qx 'ID_INPUT_JOYSTICK=1' &&
            flags+=( --dev-bind "$dev" "$dev" )
    done
    # binds below land inside the home, so it has to come first
    if [ "${CONF[runner]}" = native ]; then
        path="$DATA/native-home/$(basename "$GAME")"
        mkdir -p "$path"
        flags+=( --bind "$path" "$HOME" )
    else
        # umu-run execs Proton through the umu-shim kept here and writes install
        # markers into its runtimes, so the game gets a throwaway writable copy
        path="${XDG_DATA_HOME:-$HOME/.local/share}/umu"
        [ -d "$path" ] || die "no umu runtime yet: run quacks setup"
        flags+=( --dir "$HOME" --overlay-src "$path" --tmp-overlay "$path" --bind "$WINEPREFIX" "$WINEPREFIX" )
    fi
    # X also listens on abstract sockets, which only --unshare-net cuts off
    if [[ ${DISPLAY:-} =~ ^:([0-9]+) ]]; then
        path=/tmp/.X11-unix/X${BASH_REMATCH[1]}
        [ -S "$path" ] && flags+=( --ro-bind "$path" "$path" )
    fi
    for path in "$run/pipewire-0" "$run/pulse/native" "${XAUTHORITY:-}"; do
        [ -e "$path" ] && flags+=( --ro-bind "$path" "$path" )
    done
    flags+=( --bind "$ROOT_MNT" "$ROOT_MNT" --chdir "$RUN_DIR" --clearenv )
    while IFS= read -r name; do
        [[ $name =~ $KEEP_ENV ]] && flags+=( --setenv "$name" "${!name}" )
    done < <(compgen -e)
    # home dirs on PATH hold mise shims and other tools the game has no use for
    IFS=: read -ra parts <<<"$PATH"
    for path in "${parts[@]}"; do [[ $path == "$HOME"* ]] || paths+=("$path"); done
    flags+=( --setenv PATH "$(IFS=:; echo "${paths[*]}")" )
    for e in "${ENVS[@]}"; do flags+=( --setenv "${e%%=*}" "${e#*=}" ); done
    # IPC stays shared: X's MIT-SHM needs it to talk to the X server.
    # udev events can't reach the sandbox, so SDL must find pads by scanning
    # /dev/input itself.
    flags+=( --unshare-pid --unshare-uts --unshare-cgroup-try --new-session
             --die-with-parent --cap-drop ALL --setenv SDL_JOYSTICK_DISABLE_UDEV 1 )
    [ "${CONF[block_net]}" = 0 ] || flags+=( --unshare-net )
    bwrap "${flags[@]}" "$@"
}

find_proton() {
    local proton
    for proton in ${CONF[proton]:-}; do
        [ -d "$proton" ] && { echo "$proton"; return; }
    done
    die "none of the proton paths in $CONFIG exist"
}

# The sandbox can't download, so umu's runtime is fetched here, outside it,
# by booting a throwaway prefix: Proton's own code runs, no game does.
setup_runtime() {
    local proton tmp status
    proton=$(find_proton) || exit 1
    tmp=$(mktemp -d)
    trap 'rm -rf "$tmp"' EXIT
    WINEPREFIX="$tmp" PROTONPATH="$proton" GAMEID=umu-default \
        PRESSURE_VESSEL_VARIABLE_DIR="$tmp/pressure-vessel" umu-run wineboot -u
    status=$?
    [ $status = 0 ] || echo "quacks: umu-run failed ($status)" >&2
    return $status
}

run_game() {
    local variant=
    if [ $# -gt 0 ] && [ "$1" != -- ]; then variant=$1; shift; fi
    [ "${1:-}" = -- ] && shift
    load "$GAME/quacks.conf" "$variant"
    [ -n "${CONF[exe]:-}" ] || die "$GAME/quacks.conf: no exe"

    trap unmount_game EXIT
    mount_game || die "mounting $FL/game-root.dwarfs failed"
    trap 'exit 130' INT TERM

    ROOT_MNT="$FL/game-root"
    RUN_DIR="$ROOT_MNT${CONF[dir]:+/${CONF[dir]}}"
    local args=() cmd
    read -ra args <<<"${CONF[args]:-}"

    if [ "${CONF[runner]}" = native ]; then
        cmd=( "./${CONF[exe]}" )
    else
        local proton
        proton=$(find_proton) || exit 1
        export WINEPREFIX="$DATA/wine-prefix/$(basename "$GAME")"
        mkdir -p "$WINEPREFIX"
        # The sandbox keeps $HOME read-only, so umu must use a local Proton,
        # skip its runtime updates, and cache (pressure-vessel's runtime copy
        # included) inside the bound prefix.
        export PROTONPATH="$proton" UMU_RUNTIME_UPDATE=0 XDG_CACHE_HOME="$WINEPREFIX/.cache"
        export PRESSURE_VESSEL_VARIABLE_DIR="$WINEPREFIX/.cache/pressure-vessel"
        export WINEDLLOVERRIDES="winemenubuilder.exe=d;mshtml=d${CONF[dlls]:+;${CONF[dlls]}}"
        export WINE_LARGE_ADDRESS_AWARE=1 WINEDEBUG=fixme-all
        [ -n "${CONF[gameid]:-}" ] && export GAMEID="umu-${CONF[gameid]}"
        cmd=( umu-run "${CONF[exe]}" )
    fi
    sandbox "${cmd[@]}" "${args[@]}" "$@"
}

[ "$EUID" = 0 ] && die "refusing to run as root"

action=${1:-}
if [ "$action" = setup ]; then
    load "$CONFIG"
    setup_runtime
    exit
fi
for dep in dwarfs fuse-overlayfs bwrap flock findmnt; do
    command -v "$dep" >/dev/null || die "$dep not installed"
done
[ $# -ge 2 ] || die "usage: quacks run|mount|unmount|check|compress <game dir> [variant] [-- args], or quacks setup"
GAME=$(readlink -f "$2")
FL="$GAME/files"
[ -d "$FL" ] || die "$FL does not exist"
shift 2
load "$CONFIG"

case $action in
    check) dwarfsck --check-integrity -i "$FL/game-root.dwarfs"; exit ;;
    run|mount|unmount|compress) lock_game ;;
    *) die "unknown action '$action'" ;;
esac
case $action in
    run) run_game "$@" ;;
    mount) mount_game ;;
    unmount) unmount_game ;;
    compress)
        [ ! -e "$FL/game-root.dwarfs" ] || die "$FL/game-root.dwarfs already exists"
        # Most game assets are compressed already: the incompressible
        # categorizer stores those raw, and 4 MiB blocks keep each random
        # read from decompressing a 64 MiB one.
        mkdwarfs -l7 -S22 --categorize --order=nilsimsa --no-create-timestamp \
            -i "$FL/game-root" -o "$FL/game-root.dwarfs.part" &&
            mv "$FL/game-root.dwarfs.part" "$FL/game-root.dwarfs"
        ;;
esac
