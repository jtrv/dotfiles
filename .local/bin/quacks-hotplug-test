#!/usr/bin/env bash
# Checks quacks-hotplug against virtual gamepads in a light sandbox that sets
# up /dev the way quacks does: a pad present at launch, one added later, and
# both removed again. Removal matters most: a node left behind opens whatever
# device later reuses its number, which may be a keyboard.
# Needs the uinput group and python-evdev. Takes about 15 seconds.
set -u

tmp=$(mktemp -d)
pids=()
cleanup() { kill "${pids[@]}" 2>/dev/null; wait 2>/dev/null; rm -rf "$tmp"; }
trap cleanup EXIT
fails=0

pad() {
    python3 -c '
import sys, time
from evdev import UInput, AbsInfo, ecodes as e
ax = AbsInfo(0, -32768, 32767, 16, 128, 0)
UInput({e.EV_KEY: [e.BTN_SOUTH, e.BTN_EAST, e.BTN_NORTH, e.BTN_WEST, e.BTN_START],
        e.EV_ABS: [(e.ABS_X, ax), (e.ABS_Y, ax)]},
       name=sys.argv[1], vendor=0x045e, product=0x028e, bustype=e.BUS_USB)
time.sleep(120)' "$1" &
    pids+=($!)
}

node_of() {
    local name i dev
    for i in $(seq 50); do
        for dev in /sys/class/input/event*; do
            read -r name <"$dev/device/name" 2>/dev/null
            [ "$name" = "$1" ] && [ -c "/dev/input/${dev##*/}" ] &&
                udevadm info -q property -n "/dev/input/${dev##*/}" | grep -qx ID_INPUT_JOYSTICK=1 &&
                { echo "/dev/input/${dev##*/}"; return; }
        done
        sleep 0.1
    done
    return 1
}

# in_box <python expr on path p> <path>: evaluated inside the sandbox
in_box() {
    nsenter -t "$box" -U -m --preserve-credentials python3 -c "
import os, sys
p = sys.argv[1]
sys.exit(0 if $1 else 1)" "$2" 2>/dev/null
}

expect() {
    local what=$1 cond=$2 path=$3 i
    for i in $(seq 50); do
        in_box "$cond" "$path" && { echo "ok   $what"; return; }
        sleep 0.1
    done
    echo "FAIL $what"
    fails=$((fails + 1))
}

opens_as() { echo "open(p, 'rb') and open('/sys/class/input/' + os.path.basename(p) + '/device/name').read().strip() == '$1'"; }

pad quacks-test-early
early=$(node_of quacks-test-early) || { echo "FAIL virtual pad never appeared"; exit 1; }

"$(dirname "$0")/quacks-hotplug" "$tmp/info" 2>"$tmp/log" &
helper=$!
pids+=($helper)
bwrap --ro-bind / / --proc /proc --dev /dev --dir /dev/input \
    --dev-bind "$early" "$early" \
    --unshare-pid --unshare-net --new-session --die-with-parent --cap-drop ALL \
    --info-fd 3 sleep 60 3>"$tmp/info" &
sandbox=$!
pids+=($sandbox)
until box=$(python3 -c 'import json,sys; print(json.load(open(sys.argv[1]))["child-pid"])' "$tmp/info" 2>/dev/null); do
    sleep 0.1
done

expect "pad present at launch is visible" "$(opens_as quacks-test-early)" "$early"

pad quacks-test-late
late_pid=${pids[-1]}
late=$(node_of quacks-test-late) || { echo "FAIL second virtual pad never appeared"; exit 1; }
expect "pad added later is visible" "$(opens_as quacks-test-late)" "$late"

kill "${pids[0]}"
expect "launch-time pad is removed" "not os.path.lexists(p)" "$early"
kill "$late_pid"
expect "added pad is removed" "not os.path.lexists(p)" "$late"
expect "no staged mounts are left" "not os.listdir(p)" /dev/.quacks-hotplug

kill "$sandbox"
for i in $(seq 30); do kill -0 "$helper" 2>/dev/null || break; sleep 0.1; done
if kill -0 "$helper" 2>/dev/null; then
    echo "FAIL helper outlives the sandbox"; fails=$((fails + 1))
else
    echo "ok   helper exits with the sandbox"
fi

if [ "$fails" -gt 0 ]; then
    echo "helper log:"; cat "$tmp/log"
    exit 1
fi
