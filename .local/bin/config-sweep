#!/bin/sh
# Mechanical half of the Ownership table in ~/.config/agents/contexts/dotfiles.md.
# Run in the staging worktree after `git merge origin/<other>` (before commit):
# every owned path goes back to what HEAD had (restored if HEAD tracks it,
# removed if not), manifests report what the other side had, and files that mix
# shared and per-machine hunks are listed for review by hand, along with
# incoming deletions and files both sides changed that merged without conflict.
# Keep the lists below in sync with the table; the table stays the source of truth.
set -e
# Exported GIT_DIR/GIT_WORK_TREE would point everything below, rm -rf
# included, at the live $HOME tree. Only a linked worktree (staging) has a
# git dir distinct from the common dir; the live bare-repo setup never does.
unset GIT_DIR GIT_WORK_TREE
gd=$(git rev-parse --absolute-git-dir) || exit 1
cd_=$(cd "$(git rev-parse --git-common-dir)" && pwd)
[ "$gd" != "$cd_" ] || { echo "config-sweep: run it in the staging worktree, not live" >&2; exit 1; }
cd "$(git rev-parse --show-toplevel)"
other=$(git rev-parse -q --verify MERGE_HEAD) || { echo "no merge in progress" >&2; exit 1; }
base=$(git merge-base HEAD "$other")
t=$(mktemp -d); trap 'rm -rf "$t"' EXIT
git for-each-ref --format='%(objectname)' refs/remotes/origin | grep -qx "$other" ||
  echo "WARNING: merge source $other is not the tip of any origin/* ref (stale local branch or skipped fetch?)" >&2

owned='
.config/environment.d
.config/fontconfig/fonts.conf
.config/gamemode.ini
.config/pipewire/pipewire.conf
.local/bin/steam
.config/mozilla/firefox
.config/pacman
.config/paru
.config/systemd/user
.config/udev/rules.d
.config/nvtop
.local/bin/niri-edge-pan
.config/fish/fish_plugins
.config/mpv/shaders
.config/warehouse/arch
.config/warehouse/fish
.config/warehouse/go
.config/warehouse/ktsctl
.local/bin/mirrors
readme.md
'
# Every branch needs its own copy: a branch that never tracked one keeps the
# incoming copy instead of losing it (the shared config includes it).
perbranch='
.config/niri/local.kdl
.config/mpv/local.conf
'
manifests='
.config/warehouse/bun
.config/warehouse/uv
.config/warehouse/cargo
.config/warehouse/wud
.local/share/bun/install/global/package.json
.local/share/cargo/.crates.toml
.local/share/cargo/.crates2.json
'
mixed='
.config/fish/config.fish
.config/fish/conf.d/aliases.fish
.config/fish/conf.d/env.fish
.config/kak/rc/modes.kak
.config/mimeapps.list
.config/mise/config.toml
.config/topgrade.toml
.config/waybar/config.jsonc
.config/voxtype/config.toml
.config/waybar/style.css
.local/bin/brostak
.local/bin/exercism-dl
.local/bin/lutris-sgdb
.local/bin/nws-discussion
.local/bin/nws-forecast
'

keep_ours() {
  git rm -rfq --cached -- "$1" 2>/dev/null || true
  rm -rf "$1"
  git checkout -q HEAD -- "$1" 2>/dev/null || true
}

echo "== owned paths they changed since the merge-base (discarded, kept ours) =="
git diff --name-status "$base" "$other" -- $owned
for p in $owned $manifests; do keep_ours "$p"; done

echo "== per-branch files HEAD lacked (kept theirs; point them at this branch's host file) =="
for p in $perbranch; do
  if git cat-file -e HEAD:"$p" 2>/dev/null; then keep_ours "$p"; else git checkout -q "$other" -- "$p" 2>/dev/null && echo "$p"; fi
done

echo "== theirs only (manifests, kept ours) =="
for p in $manifests; do
  case $p in
    # one long JSON line; .crates.toml carries the same entries
    .local/share/cargo/.crates2.json) continue ;;
    # report package names only: version bumps here are noise
    */package.json|*/.crates.toml)
      re='s/^    "\([^"]*\)": ".*/\1/p; s/^"\([^ ]*\) .*/\1/p'
      git show HEAD:"$p" 2>/dev/null | sed -n "$re" | sort -u >"$t/n-ours"
      git show "$other":"$p" 2>/dev/null | sed -n "$re" | sort -u >"$t/n-theirs"
      lines=$(comm -13 "$t/n-ours" "$t/n-theirs") ;;
    *) lines=$(git diff HEAD "$other" -- "$p" | sed -n '/^+++ /d; s/^+//p') ;;
  esac
  [ -n "$lines" ] && printf "%s\n%s\n\n" "$p" "$lines"
done

echo "== review by hand (shared + per-machine hunks) =="
for p in $mixed; do
  git diff --quiet HEAD -- "$p" 2>/dev/null && git diff --cached --quiet HEAD -- "$p" 2>/dev/null || echo "$p"
done
echo "== incoming deletions (restore ours with: git checkout HEAD -- <path>) =="
git diff --cached --diff-filter=D --name-status HEAD

echo "== changed on both sides, merged without conflict (check for doubled changes) =="
git diff --name-only "$base" HEAD | sort >"$t/ours"
git diff --name-only "$base" "$other" | sort >"$t/theirs"
git diff --cached --name-only HEAD | sort >"$t/staged"
git diff --name-only --diff-filter=U | sort >"$t/unmerged"
comm -12 "$t/ours" "$t/theirs" | comm -12 - "$t/staged" | comm -23 - "$t/unmerged"

echo "== remaining conflicts =="
git diff --name-only --diff-filter=U
