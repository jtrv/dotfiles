#!/bin/sh

icon_name="audio-input-microphone"

# Send a "running" notification and capture its ID ('-p' prints ID to stdout)
notification_id=$(dunstify -p -t 0 -i "$icon_name" "Dictation Running" "Nerd Dictation is listening...")

nerd-dictation begin --numbers-as-digits --numbers-use-separator --timeout 2

# Close the initial notification
dunstify -C "$notification_id"

# Send the "finished" notification
dunstify -t 3000 "Dictation Finished" "Nerd Dictation has stopped listening."
