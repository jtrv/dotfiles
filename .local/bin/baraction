#!/bin/sh

# --- Configuration ---
# Interface and Device Names
NET_IFACE="wlan0"
BAT_NAME="BAT0"

# Paths
BAT_CAP="/sys/class/power_supply/$BAT_NAME/capacity"
BAT_STATUS="/sys/class/power_supply/AC/online"
NET_OPER="/sys/class/net/$NET_IFACE/operstate"

# Refresh rates (counter limits)
# If main loop sleeps 2s: 30 ticks = 60s
DISK_UPDATE_INTERVAL=30
BLU_UPDATE_INTERVAL=5

# --- Initialization ---
# 1. Detect Mic LED
MIC_LED=""
for led in /sys/class/leds/*micmute*/brightness; do
    [ -f "$led" ] && MIC_LED="$led" && break
done

# 2. CPU History
read -r _ cpu_a cpu_b cpu_c cpu_idle _ < /proc/stat
cpu_prev_total=$((cpu_a + cpu_b + cpu_c + cpu_idle))
cpu_prev_idle=$cpu_idle

# 3. Pre-initialize variables to prevent empty display on first run
tick_disk=$DISK_UPDATE_INTERVAL
tick_blu=$BLU_UPDATE_INTERVAL
ssd_percent=0
blu_icon="󰂲"

# --- Signal Handling ---
# Create a pipe to handle signals for instant updates
# This allows us to sleep long but wake up instantly on events
TRAP_FILE="/tmp/baraction_trap"
[ ! -p "$TRAP_FILE" ] && mkfifo "$TRAP_FILE"

# Background process to handle sleep/interrupt
# Reads from pipe (blocking) or times out
(
    while :; do
        # Read with timeout. If signal received, loop continues immediately.
        # If timeout, loop continues after N seconds.
        # We read the desired sleep time from a file or default to 2
        read -t 2 _ <> "$TRAP_FILE"
    done
) &
TIMER_PID=$!

# Ensure we kill the timer subshell on exit
trap 'kill $TIMER_PID; rm "$TRAP_FILE"; exit' INT TERM EXIT

# --- Main Loop ---
while :; do
    # --- 1. BATTERY & DYNAMIC SLEEP ---
    # We check power first to determine sleep strategy
    read -r bat_ac < "$BAT_STATUS"
    read -r bat_cap < "$BAT_CAP"

    if [ "$bat_ac" = "1" ]; then
        bat_icon="⚡ "
        # On AC: Update faster (e.g., 1s or 2s)
        CURRENT_SLEEP=2
    else
        # On Battery: Update slower (e.g., 5s) to save power
        CURRENT_SLEEP=5
        # Efficient case statement for ranges
        case "$bat_cap" in
            100|9[0-9]) bat_icon="" ;;
            [6-8][0-9]) bat_icon="" ;;
            [4-5][0-9]) bat_icon="" ;;
            [1-3][0-9]) bat_icon="" ;;
            *)          bat_icon="" ;;
        esac
    fi

    # --- 2. CPU ---
    read -r _ cpu_a cpu_b cpu_c cpu_idle _ < /proc/stat
    cpu_total=$((cpu_a + cpu_b + cpu_c + cpu_idle))
    diff_total=$((cpu_total - cpu_prev_total))
    diff_idle=$((cpu_idle - cpu_prev_idle))

    if [ "$diff_total" -gt 0 ]; then
        cpu_usage=$((100 * (diff_total - diff_idle) / diff_total))
    else
        cpu_usage=0
    fi
    cpu_prev_total=$cpu_total
    cpu_prev_idle=$cpu_idle

    # --- 3. RAM ---
    while read -r name value _; do
        case "$name" in
            MemTotal:) ram_total=$value ;;
            MemAvailable:) ram_avail=$value ;;
        esac
        [ -n "$ram_total" ] && [ -n "$ram_avail" ] && break
    done < /proc/meminfo

    ram_usage=$((ram_total - ram_avail))
    ram_percent=$((100 * ram_usage / ram_total))
    unset ram_total ram_avail

    # --- 4. SSD (Interval Limited) ---
    # Only run this heavy check every N loops
    if [ "$tick_disk" -ge "$DISK_UPDATE_INTERVAL" ]; then
        # Pure sh parsing of df (avoids 'tail')
        # We assume df -P output format: Filesystem Blocks Used Available Capacity Mounted
        df -P /home | {
            read _ # Skip header
            read _ _ _ _cap _
            echo "${_cap%\%}"
        } | read -r ssd_percent
        tick_disk=0
    else
        tick_disk=$((tick_disk + 1))
    fi

    # --- 5. MIC MUTE ---
    if [ -n "$MIC_LED" ]; then
        read -r brightness < "$MIC_LED"
        if [ "$brightness" = "1" ]; then
            mic_icon=""
        else
            mic_icon=""
        fi
    fi

    # --- 6. BLUETOOTH (Interval Limited) ---
    # Checking file globs is disk I/O, slow it down
    if [ "$tick_blu" -ge "$BLU_UPDATE_INTERVAL" ]; then
        blu_icon="󰂲"
        for f in /sys/class/bluetooth/*/powered; do
            if [ -f "$f" ]; then
                read -r state < "$f"
                if [ "$state" = "1" ]; then
                    blu_icon="󰂱"
                    break
                fi
            fi
        done
        tick_blu=0
    else
        tick_blu=$((tick_blu + 1))
    fi

    # --- 7. NET ---
    read -r net_state < "$NET_OPER" 2>/dev/null
    if [ "$net_state" = "up" ]; then
        net_icon=""
    else
        net_icon="󰖪"
    fi

    # --- Output ---
    printf " %3d%%  %3d%% 󰋊 %3d%% %s%3d%% %s %s %s \n" \
        "$cpu_usage" "$ram_percent" "$ssd_percent" \
        "$bat_icon" "$bat_cap" \
        "$mic_icon" "$blu_icon" "$net_icon"

    # --- Wait ---
    # Sleep via `read` on a pipe with timeout.
    # This replaces 'sleep' and allows instant wakeups if you write to the pipe.
    read -t "$CURRENT_SLEEP" _ <> "$TRAP_FILE"
done
