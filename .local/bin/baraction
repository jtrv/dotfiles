#!/bin/sh

# Global state
prev_total=0
prev_idle=0
ssd_str=""
tick=0

update_cpu() {
  read -r _ user nice system idle iowait irq softirq steal _ < /proc/stat

  idle=${idle:-0}; iowait=${iowait:-0}; user=${user:-0}
  nice=${nice:-0}; system=${system:-0}; irq=${irq:-0}
  softirq=${softirq:-0}; steal=${steal:-0}

  total=$((user + nice + system + idle + iowait + irq + softirq + steal))
  current_idle=$((idle + iowait))

  diff_idle=$((current_idle - prev_idle))
  diff_total=$((total - prev_total))
  [ "$diff_total" -eq 0 ] && diff_total=1

  usage=$(( (100 * (diff_total - diff_idle) + (diff_total / 2)) / diff_total ))

  prev_total=$total
  prev_idle=$current_idle

  cpu_str=" $(printf '%3d%%' "$usage")"
}

update_ram() {
  while read -r name value _; do
    case "$name" in
      MemTotal:) mem_total=$value ;;
      MemAvailable:)
        mem_avail=$value
        break # Exit loop immediately to save CPU cycles
        ;;
    esac
  done < /proc/meminfo

  [ -z "$mem_avail" ] && mem_avail=$mem_total

  used=$((mem_total - mem_avail))
  percent=$(( (100 * used + (mem_total / 2)) / mem_total ))
  ram_str=" $(printf '%3d%%' "$percent")"
}

update_ssd() {
  # df -P header has 7 words, data has 6. The 12th word is the % capacity.
  set -- $(df -P /home)
  percent=${12%\%} # Extracts the 12th param and strips the '%' character
  ssd_str="󰋊 $(printf '%3d%%' "$percent")"
}

update_vol() {
  raw_vol=$(wpctl get-volume @DEFAULT_AUDIO_SINK@ 2>/dev/null)

  case "$raw_vol" in
    *"[MUTED]"*) icon="" ;;
    *) icon="" ;;
  esac

  # Pure shell string manipulation to convert "Volume: 0.45" to integer "45"
  vol_str=${raw_vol#Volume: }        # Strip prefix
  vol_str=${vol_str%% *}             # Strip [MUTED] if present
  vol_str=${vol_str%.*}${vol_str#*.} # Remove decimal point (0.45 -> 045)

  # Safely strip leading zeros to prevent octal math errors
  while [ "${vol_str#0}" != "$vol_str" ]; do
    vol_str=${vol_str#0}
  done

  vol=${vol_str:-0} # Default to 0 if string is empty
  vol_str="$icon $(printf '%3d%%' "$vol")"
}

update_mic() {
  raw_mic=$(wpctl get-volume @DEFAULT_AUDIO_SOURCE@ 2>/dev/null)
  case "$raw_mic" in
    *"[MUTED]"*) mic_str="" ;;
    *) mic_str="" ;;
  esac
}

update_net() {
  read -r state < /sys/class/net/enp6s0/operstate 2>/dev/null || state="down"
  if [ "$state" = "up" ]; then
    net_str=""
  else
    net_str="󰖪"
  fi
}

update_blu() {
  blu_str="󰂲"
  for f in /sys/class/bluetooth/hci*/powered; do
    if [ -f "$f" ]; then
      read -r p < "$f" 2>/dev/null
      if [ "$p" = "1" ]; then
        blu_str="󰂱"
        break # Exit immediately on first active device
      fi
    fi
  done
}

SLEEP_SEC=2

# Initialize SSD on first run
update_ssd

while :; do
  update_cpu
  update_ram
  update_net
  update_blu
  update_mic

  # Tick-based execution: Only check SSD every 60 seconds (30 ticks)
  # This drastically cuts down on unnecessary disk queries.
  if [ $((tick % 30)) -eq 0 ]; then
    update_ssd
  fi

  printf "%s  %s  %s  %s  %s   %s  \n" "$cpu_str" "$ram_str" "$ssd_str" "$blu_str" "$net_str" "$mic_str"

  tick=$(( (tick + 1) % 30 ))
  sleep "$SLEEP_SEC"
done
