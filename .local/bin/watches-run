#!/bin/sh
# Run all claude watch probes in parallel, printing each as it finishes; desktop-notify any that hit CHECK.
set -- "$HOME"/.config/agents/watches/*.sh
[ -e "$1" ] || { echo "no probes found" >&2; exit 1; }
for probe; do
  (
    name=$(basename "$probe" .sh)
    out=$("$probe" 2>/dev/null)
    case "$out" in
      CHECK*|UNKNOWN*) notify-send -u normal -t 0 -a watches "watch: $name" "$out" ;;
    esac
    # one write per probe keeps multi-line output in one piece (atomic under PIPE_BUF)
    printf '%s: %s\n' "$name" "${out:-UNKNOWN: probe produced no output}"
  ) &
done
wait
